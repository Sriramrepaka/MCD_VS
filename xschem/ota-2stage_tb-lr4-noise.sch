C {vsource.sym} 1230 100 0 0 {name=V2 value="dc 0.8" savecurrent=false}
C {devices/code_shown.sym} -580 -970 0 0 {name=NGSPICE only_toplevel=true 
value="
.temp 27
.control
option sparse
set filetype=ascii
save all

*op
*write ota-5t_tb-noise.raw
*set appendwrite

ac dec 101 1k 1MEG
*write ota-5t_tb-noise.raw
plot 20*log10(v_lpf)
plot 20*log10(v_hpf)

noise v(v_lpf) Vin lin 1000 1MEG 1000MEG 1
let noise_lpf = onoise_total
print noise_lpf
print inoise_total

setplot noise1
plot inoise_spectrum linplot
plot onoise_spectrum linplot

noise v(v_hpf) Vin lin 1000 1MEG 1000MEG 1
let noise_hpf = onoise_total
print noise_hpf
print inoise_total

.endc
"}
C {devices/title.sym} 140 290 0 0 {name=l8 author=""}
