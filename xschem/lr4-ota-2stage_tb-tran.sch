C {devices/code_shown.sym} -2510 -1200 0 0 {name=NGSPICE only_toplevel=true 
value="
.temp 27

.ic v(v_lpf)=0 v(v_hpf)=0
.option method=gear

.control

* Simulates up to 280us
tran 0.005u 280u uic


plot v_in v_lpf v_hpf

let vin_limit=0.8
meas tran tstart WHEN v(v_in)=vin_limit

meas tran v_final_lpf FIND v(v_lpf) AT=200u
meas tran v_final_hpf FIND v(v_hpf) AT=200u

meas tran tcross_lpf WHEN v(v_lpf)=\{v_final_lpf + (0.8*0.01)\} LAST

meas tran tcross_hpf WHEN v(v_hpf)=\{v_final_hpf - (0.8*0.01)\} LAST

let tsettle_lpf=tcross_lpf-tstart
let tsettle_hpf=tcross_hpf-tstart

print tstart
print tcross_lpf
print tcross_hpf
print tsettle_lpf
print tsettle_hpf

* Convert from seconds to microseconds so CACE can log it under your 'us' unit spec!
*let tsettle_us = tsettle * 1e6
*echo $&tsettle_us > CACE\{simpath\}/CACE\{filename\}_CACE\{N\}.data

.endc
"}
C {devices/code_shown.sym} -2510 -300 0 0 {name=MODEL1 only_toplevel=true
format="tcleval( @value )"
value=".lib cornerMOSlv.lib mos_ss
.lib cornerCAP.lib cap_typ
.lib cornerRES.lib res_typ
"}
