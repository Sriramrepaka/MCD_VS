C {devices/code_shown.sym} -1030 60 0 0 {name=MODEL only_toplevel=true
format="tcleval( @value )"
value="
.lib cornerMOSlv.lib mos_CACE\{corner\}
.lib cornerMOShv.lib mos_CACE\{corner\}
.lib cornerRES.lib res_CACE\{corner_res\}
.lib cornerCAP.lib cap_CACE\{corner_cap\}
"}
C {devices/code_shown.sym} -1030 -900 0 0 {name=NGSPICE only_toplevel=true
value="
.include CACE\{DUT_path\}
.temp CACE\{temp\}
.param mc_ok = CACE\{sigma=1\}
.option SEED=CACE[CACE\{seed=12345\} + CACE\{iterations=0\}]

.control
set num_threads=1

* Run DC operating point to ensure both OTAs are biased correctly
op

* Sweep from 10 Hz to 1 MHz
ac dec 101 10 1MEG

* 1. Measure Passband Gains
meas ac acgain_lpf MAX vmag(v_lpf) FROM=10 TO=1k
meas ac acgain_hpf MAX vmag(v_hpf) FROM=100k TO=1000k

* 2. Define the -6dB Linkwitz-Riley Targets (Voltage / 2)
let f6db_lpf = acgain_lpf / 2
let f6db_hpf = acgain_hpf / 2

* 3. Find the Cutoff Frequencies
meas ac fc_lpf WHEN vmag(v_lpf)=f6db_lpf FALL=1
meas ac fc_hpf WHEN vmag(v_hpf)=f6db_hpf RISE=1

* 4. CRITICAL ADDITION: Extract the Phase Difference at the 10kHz Crossover
meas ac phase_lpf find vp(v_lpf) at=10k
meas ac phase_hpf find vp(v_hpf) at=10k
let phase_error = abs(phase_lpf - phase_hpf)

* Export all 5 calculated parameters sequentially for CACE to log
echo $&acgain_lpf $&fc_lpf $&acgain_hpf $&fc_hpf $&phase_error > CACE\{simpath\}/CACE\{filename\}_CACE\{N\}.data
.endc
"}
